#
# Uninstall script: `cmake --build <build-dir> --target uninstall` runs it.
# Removes every path recorded in install_manifest.txt, then drops the data
# directory if it is now empty.

if(NOT EXISTS "@CMAKE_CURRENT_BINARY_DIR@/install_manifest.txt")
    message(FATAL_ERROR
        "Cannot find install_manifest.txt in @CMAKE_CURRENT_BINARY_DIR@")
endif()

file(READ "@CMAKE_CURRENT_BINARY_DIR@/install_manifest.txt" wc_manifest)
string(REGEX REPLACE "\n" ";" wc_manifest "${wc_manifest}")

# install_manifest.txt records the final destination paths without the
# DESTDIR prefix; a staged install (cmake --install with DESTDIR set) is
# uninstalled from the staging root by re-adding the prefix.
if(DEFINED ENV{DESTDIR})
    set(wc_destdir "$ENV{DESTDIR}")
else()
    set(wc_destdir "")
endif()

foreach(wc_file ${wc_manifest})
    set(wc_path "${wc_destdir}${wc_file}")
    if(IS_SYMLINK "${wc_path}" OR EXISTS "${wc_path}")
        file(REMOVE "${wc_path}")
        message(STATUS "Removed: ${wc_path}")
    else()
        message(STATUS "File ${wc_file} does not exist.")
    endif()
endforeach()

# Drop the share/wchanger data directory if it is now empty.  Its location
# is derived from a manifest entry (wms.json), so it works for staged
# installs too.
foreach(wc_file ${wc_manifest})
    if(wc_file MATCHES "/wchanger/wms\\.json$")
        set(wc_datadir "${wc_destdir}${wc_file}")
        get_filename_component(wc_datadir "${wc_datadir}" DIRECTORY)
        if(IS_DIRECTORY "${wc_datadir}")
            file(GLOB wc_residual "${wc_datadir}/*")
            if(NOT wc_residual)
                file(REMOVE_RECURSE "${wc_datadir}")
                message(STATUS "Removed empty directory: ${wc_datadir}")
            endif()
        endif()
        break()
    endif()
endforeach()
