_wchangercfg()
{
    local cur prev words cword
    _init_completion || return

    case $prev in
        --config)
            _filedir
            return
            ;;
    esac

    if [[ "$cur" == -* ]]; then
        COMPREPLY=( $(compgen -W '$(_parse_help "$1")' -- "$cur") )
        return
    fi

} &&
complete -F _wchangercfg wchangercfg

