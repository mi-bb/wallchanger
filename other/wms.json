      ],
      "Command":"gsettings set org.gnome.desktop.background picture-uri \"file:\/\/[F]\""
   },
   "Cinnamon":{
      "Proc":[
         "cinnamon-sessio",
         "cinnamon-session",
         "cinnamon"
      ],
      "Command":"gsettings set org.cinnamon.desktop.background picture-uri \"file:\/\/[F]\""
